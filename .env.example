# Public HTTPS base URL (e.g. your Tailscale Funnel hostname)
MCP_PUBLIC_BASE=https://your-node.ts.net

# GitHub OAuth App Client ID and your numeric GitHub user ID (single-owner allowlist)
MCP_GITHUB_CLIENT_ID=your_github_oauth_client_id
MCP_GITHUB_OWNER_ID=123456789

# Local HTTP listener port and MCP endpoint path
MCP_PROBE_PORT=8766
MCP_PROBE_PATH=/mcp

# Workspace name -> local directory mapping (JSON object)
MCP_WORKSPACES={"work":"C:/Workspaces/work","docs":"C:/Workspaces/docs"}

# Dynamic Client Registration (DCR) protection
# Set to 1 during initial Gemini App linking, then set to 0 for daily lockdown
MCP_ALLOW_DCR=1
MCP_MAX_REGISTERED_CLIENTS=32

# Optional overrides for external CLI tools (otherwise resolved via PATH)
# MCP_ES_PATH=C:/Users/you/Tools/bin/es.exe
# MCP_RG_PATH=C:/Users/you/Tools/bin/rg.exe
# MCP_AST_GREP_PATH=C:/Users/you/Tools/bin/ast-grep.exe
# MCP_GIT_PATH=C:/Program Files/Git/cmd/git.exe